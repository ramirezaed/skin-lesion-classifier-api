{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "db/**/*.ts",
    "routes/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
